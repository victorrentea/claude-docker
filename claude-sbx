#!/usr/bin/env bash
# Host-side launcher for Claude Code inside a Docker Sandbox, via the standalone
# `sbx` CLI — Docker Sandboxes (https://docs.docker.com/ai/sandboxes).
#
# A lighter sibling of `claude-docker`: instead of a hand-built image plus an
# iptables firewall, this delegates to Docker Sandboxes, which manages the
# microVM, the workspace bind-mount, a host-side network policy, and a
# credential-brokering proxy.
#
# ── AUTH — Docker brokers Anthropic credentials via a HOST-SIDE proxy ──
#   The agent inside the sandbox sends the sentinel `proxy-managed`; for the
#   configured Anthropic hosts the proxy swaps it for a credential REGISTERED
#   ON THE HOST. The real secret never enters the sandbox. Register yours once:
#     • Subscription (Pro/Max): run  /login  inside Claude Code (OAuth on host).
#     • API key:  echo "$ANTHROPIC_API_KEY" | sbx secret set -g anthropic
#   Do NOT set keys manually inside the sandbox (the proxy overrides auth for
#   the configured hosts, so an unregistered credential yields
#   "credit balance is too low"). Note: `sbx secret --oauth` is openai-only, so
#   an Anthropic *subscription* must go through /login, not `sbx secret`.
#
# ── NETWORK — one GLOBAL policy, machine-wide (sbx policy init <p>) ──
#     allow-all | balanced | deny-all
#   `balanced` (the default here) permits AI services + package registries and
#   blocks the rest — a sane default for Claude. This launcher initializes the
#   global policy only when it is not set yet; it NEVER clobbers an existing one
#   (that would affect all your sandboxes). Set CLAUDE_SBX_POLICY=deny-all to
#   start locked down — the hosts in allowlist.txt are then allowed so Claude
#   can still reach Anthropic + registries.
#
# Usage:
#   claude-sbx                    # run claude in the current directory
#   claude-sbx <claude-args...>   # forwarded to claude (e.g. --continue, -p ...)
#   claude-sbx shell              # open a shell inside the sandbox
#   claude-sbx statusline         # (re)install the host statusline into the sandbox
#   claude-sbx policy             # show the global network policy
#   claude-sbx logs               # show this sandbox's allow/block log
#   claude-sbx stop               # stop the sandbox (state is kept)
#   claude-sbx rm                 # remove the sandbox
#   claude-sbx ls                 # list sandboxes
#
# Env overrides:
#   CLAUDE_SBX_WORKSPACE   host dir to mount              (default: $PWD)
#   CLAUDE_SBX_NAME        sandbox name                   (default: claude-<dir>)
#   CLAUDE_SBX_POLICY      global net policy if unset     (default: balanced)
#   CLAUDE_SBX_ALLOWLIST   hosts to allow under deny-all  (default: shared allowlist.txt)
#   CLAUDE_SBX_TEMPLATE    container template image       (passed to -t)
#   CLAUDE_SBX_STATUSLINE  host statusline script to mirror inside the sandbox
#                          (default: the .statusLine.command from ~/.claude/settings.json)
#   CLAUDE_SBX_NO_STATUSLINE=1   don't install the statusline into the sandbox
set -euo pipefail

command -v sbx >/dev/null 2>&1 \
    || { echo "[claude-sbx] 'sbx' not found. Install: brew install docker/tap/sbx" >&2; exit 1; }

WORKSPACE="${CLAUDE_SBX_WORKSPACE:-$(pwd -P)}"
POLICY="${CLAUDE_SBX_POLICY:-balanced}"
ALLOWLIST_FILE="${CLAUDE_SBX_ALLOWLIST:-$HOME/workspace/claude-docker/allowlist.txt}"

# sbx sandbox names: letters, digits, . + - (no underscore, unlike the old plugin).
default_name="claude-$(basename "$WORKSPACE")"
default_name="$(printf '%s' "$default_name" | tr -c 'A-Za-z0-9.+-' '-')"
NAME="${CLAUDE_SBX_NAME:-$default_name}"

TEMPLATE_ARGS=()
[ -n "${CLAUDE_SBX_TEMPLATE:-}" ] && TEMPLATE_ARGS=( -t "$CLAUDE_SBX_TEMPLATE" )

# Host statusline script to mirror inside the sandbox. Resolve from the user's
# settings.json (.statusLine.command); fall back to the conventional path.
STATUSLINE_SRC="${CLAUDE_SBX_STATUSLINE:-}"
if [ -z "$STATUSLINE_SRC" ]; then
    STATUSLINE_SRC="$(jq -r '.statusLine.command // empty' "$HOME/.claude/settings.json" 2>/dev/null || true)"
    [ -n "$STATUSLINE_SRC" ] || STATUSLINE_SRC="$HOME/.claude/statusline-command.sh"
fi
SBX_STATUSLINE_DEST="/home/agent/.claude/statusline-command.sh"

require_login() {
    # `sbx ls` exits non-zero when not signed in to Docker.
    if ! sbx ls >/dev/null 2>&1; then
        echo "[claude-sbx] not signed in to Docker. Run:  sbx login" >&2
        exit 1
    fi
}

ensure_policy() {
    # The global network policy must exist before the first sandbox starts.
    # `sbx policy ls` exits non-zero until it is initialized.
    if sbx policy ls >/dev/null 2>&1; then
        return 0   # already initialized — leave the user's choice untouched
    fi
    echo "[claude-sbx] initializing GLOBAL network policy: $POLICY" >&2
    sbx policy init "$POLICY" >/dev/null
    if [ "$POLICY" = "deny-all" ] && [ -f "$ALLOWLIST_FILE" ]; then
        local hosts n
        hosts="$(grep -vE '^\s*(#|$)' "$ALLOWLIST_FILE" | paste -sd, -)"
        n="$(grep -vcE '^\s*(#|$)' "$ALLOWLIST_FILE")"
        if [ -n "$hosts" ]; then
            echo "[claude-sbx] allowing $n hosts from allowlist.txt" >&2
            sbx policy allow network "$hosts" >/dev/null
        fi
    fi
}

sandbox_exists() { sbx ls 2>/dev/null | grep -Fq -- "$NAME"; }

ensure_sandbox() {
    if ! sandbox_exists; then
        echo "[claude-sbx] creating sandbox '$NAME' for $WORKSPACE..." >&2
        sbx create --name "$NAME" ${TEMPLATE_ARGS[@]+"${TEMPLATE_ARGS[@]}"} claude "$WORKSPACE" >/dev/null
    fi
}

# Mirror the host statusline into the sandbox, ported from macOS/BSD to the
# sandbox's Linux (uutils/GNU) date+stat, and prefixed with a magenta "sbx"
# badge so you always know you're inside a sandbox. Idempotent; runs each launch
# so host edits propagate. The three sed rules track these host lines:
#   date -r "$reset"                              -> date -d @"$reset"
#   stat -f %m                                    -> stat -c %Y
#   date -j -u -f "%Y-%m-%dT%H:%M:%S" "$ts_clean" -> date -u -d "$ts_clean"
configure_statusline() {
    [ "${CLAUDE_SBX_NO_STATUSLINE:-0}" = "1" ] && return 0
    [ -f "$STATUSLINE_SRC" ] || return 0
    if ! sed \
            -e 's|date -r "$reset"|date -d @"$reset"|g' \
            -e 's|stat -f %m|stat -c %Y|g' \
            -e 's|date -j -u -f "%Y-%m-%dT%H:%M:%S" "$ts_clean"|date -u -d "$ts_clean"|g' \
            -e 's|^echo "$out"$|echo "${ESC}[1;35msbx${RESET} $out"|' \
            "$STATUSLINE_SRC" \
        | sbx exec -i "$NAME" sh -c "umask 022; mkdir -p /home/agent/.claude; cat > '$SBX_STATUSLINE_DEST'; chmod +x '$SBX_STATUSLINE_DEST'" >/dev/null 2>&1
    then
        echo "[claude-sbx] note: could not install statusline into '$NAME'" >&2
        return 0
    fi
    # Point settings.json at it, preserving every existing key (e.g. proxy auth).
    sbx exec "$NAME" sh -c \
        "jq '.statusLine={type:\"command\",command:\"$SBX_STATUSLINE_DEST\",refreshInterval:1}' /home/agent/.claude/settings.json > /home/agent/.claude/settings.json.tmp && mv /home/agent/.claude/settings.json.tmp /home/agent/.claude/settings.json" \
        >/dev/null 2>&1 || true
}

print_banner() {
    local sep='══════════════════════════════════════════════════════════════════════'
    printf '\n%s\n' "$sep"
    printf ' claude-sbx · Docker Sandboxes (sbx)\n'
    printf '%s\n' "$sep"
    printf ' sandbox        %s\n' "$NAME"
    printf ' workspace      %s  (mounted at same path)\n' "$WORKSPACE"
    printf ' net policy     global — see: claude-sbx policy\n'
    printf ' auth           proxy-brokered on host; first time run  /login  in Claude Code\n'
    printf '                (subscription; do NOT set keys inside the sandbox)\n'
    printf '%s\n\n' "$sep"
}

cmd="${1:-}"
case "$cmd" in
    shell)
        require_login
        sbx exec -it "$NAME" bash 2>/dev/null || sbx exec -it "$NAME" sh
        ;;
    policy)
        sbx policy ls
        ;;
    logs|log)
        sbx policy log "$NAME"
        ;;
    stop)
        sbx stop "$NAME"
        ;;
    rm|remove|delete)
        sbx rm -f "$NAME"
        ;;
    ls|list)
        sbx ls
        ;;
    statusline)
        require_login
        ensure_policy
        ensure_sandbox
        configure_statusline
        echo "[claude-sbx] statusline installed into '$NAME'." >&2
        ;;
    *)
        require_login
        ensure_policy
        print_banner
        ensure_sandbox
        configure_statusline
        # Re-attach by name; the agent is read from the sandbox spec.
        if [ "$#" -gt 0 ]; then
            exec sbx run --name "$NAME" -- "$@"
        else
            exec sbx run --name "$NAME"
        fi
        ;;
esac
